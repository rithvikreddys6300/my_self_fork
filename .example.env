# Example Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# AI Provider Configuration
# Get your API key from https://together.ai
TOGETHER_API_KEY=your_together_ai_api_key_here

# Authentication (Clerk)
# Get your keys from https://clerk.dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Database (Upstash Redis)
# Get your Redis URL and token from https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# File Storage (AWS S3)
# Get your AWS credentials from https://aws.amazon.com
S3_UPLOAD_REGION=us-east-1
S3_UPLOAD_KEY=your_aws_access_key_id
S3_UPLOAD_SECRET=your_aws_secret_access_key
S3_UPLOAD_BUCKET=your-s3-bucket-name

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Site Branding & Configuration
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=ResumeToSite
NEXT_PUBLIC_SITE_DISPLAY_NAME=Resume to Website Builder
NEXT_PUBLIC_SITE_DESCRIPTION=Transform your resume into a professional website instantly. Powered by AI.

# GitHub Integration
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-username/resume-to-site
NEXT_PUBLIC_DISABLE_GITHUB=false

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com

# Monitoring & Observability (Helicone)
HELICONE_API_KEY=your_helicone_api_key_here

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================

# Content Moderation
ENABLE_CONTENT_MODERATION=true

# Logging Level
LOG_LEVEL=info